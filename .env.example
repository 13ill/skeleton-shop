# Development environment (with local backend API)
# Copy this file to .env.local for local development

# API base URL - set to local backend for testing
VITE_API_BASE_URL=http://localhost:3001

# Site name
VITE_SITE_NAME=Jump-1

# Contact links (optional)
VITE_LINE_URL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=

# Feature flags
VITE_ENABLE_ANALYTICS=false
