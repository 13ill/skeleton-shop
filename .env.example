# Development environment (local static JSON)
# Copy this file to .env.local for local development

# API base URL - empty for dev (static JSON in public/Product/)
VITE_API_BASE_URL=

# Site name
VITE_SITE_NAME=Jump-1

# Contact links (optional)
VITE_LINE_URL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=

# Feature flags
VITE_ENABLE_ANALYTICS=false
