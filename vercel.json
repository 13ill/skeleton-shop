{
  "version": 2,
  "buildCommand": "node scripts/build-products.cjs && vite build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "api/seo.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/robots.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sitemap.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/seo"
    },
    {
      "source": "/((?!assets/|api/|Product/|uploads/|vite.svg|manifest.json|sw.js|favicon.ico|robots.txt|sitemap.xml).*)",
      "destination": "/api/seo"
    }
  ]
}