{
  "buildCommand": "node scripts/build-products.cjs && vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/seo.js": {
      "maxDuration": 10
    },
    "api/robots.js": {
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/seo"
    },
    {
      "source": "/((?!assets/|api/|Product/|uploads/|vite.svg|manifest.json|sw.js|favicon.ico|robots.txt|sitemap.xml).*)",
      "destination": "/api/seo"
    }
  ]
}