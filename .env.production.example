# Production environment (with backend API)
# Copy this file to .env.production for production builds

# API base URL - set to your backend API endpoint
VITE_API_BASE_URL=https://jump-1-backend-production.up.railway.app

# Site name
VITE_SITE_NAME=Jump-1

# Contact links
VITE_LINE_URL=https://line.me/...
VITE_FACEBOOK_URL=https://facebook.com/...
VITE_INSTAGRAM_URL=https://instagram.com/...

# Feature flags
VITE_ENABLE_ANALYTICS=true
